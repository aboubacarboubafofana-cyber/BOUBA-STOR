{
  "rewrites": [
    { "source": "/p/:id", "destination": "/api/p?id=:id" },
    { "source": "/b/:id", "destination": "/api/b?id=:id" }
  ],
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, s-maxage=86400, stale-while-revalidate=86400" }
      ]
    }
  ]
}

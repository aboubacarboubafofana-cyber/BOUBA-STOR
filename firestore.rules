rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{u} {
      allow read: if request.auth != null;
      allow write: if request.auth.uid == u;
    }
    match /msgs/{m} {
      allow read: if request.auth.uid in resource.data.p;
      allow create: if request.auth.uid == request.resource.data.from;
    }
    match /news/{n} {
      allow read: if request.auth != null;
      allow create: if request.auth.uid == request.resource.data.from;
      allow delete: if request.auth.uid == resource.data.from;
    }
    match /calls/{c} {
      allow read: if request.auth.uid in resource.data.p;
      allow create: if request.auth.uid in request.resource.data.p;
    }
    match /sig/{s} {
      allow create: if request.auth.uid == request.resource.data.from;
      allow read, delete: if request.auth.uid == resource.data.to;
    }
  }
}

rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {

    match /users/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth.uid == uid
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 50;
      allow delete: if false;

      match /private/{d} {
        allow read, write: if request.auth.uid == uid;
      }
    }

    match /status/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.t is number
        && request.resource.data.img.size() < 900000;
      allow delete: if request.auth.uid == resource.data.uid;
      allow update: if false;
    }

    // chatId = uidA_uidB
    match /chats/{chatId}/messages/{m} {
      allow read: if request.auth != null && request.auth.uid in chatId.split('_');
      allow create: if request.auth != null
        && request.auth.uid in chatId.split('_')
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 2000;
      allow update, delete: if false;
    }

    // Appels (Call.html) : calls/{id} avec from, to, offer, answer, status
    // + sous-collections offerCandidates / answerCandidates
    match /calls/{callId} {
      allow create: if request.auth != null
        && request.resource.data.from == request.auth.uid;
      allow read, update: if request.auth != null
        && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow delete: if false;

      match /{sub}/{candId} {
        allow read, create: if request.auth != null && (
          get(/databases/$(db)/documents/calls/$(callId)).data.from == request.auth.uid ||
          get(/databases/$(db)/documents/calls/$(callId)).data.to == request.auth.uid);
      }
    }
    // appel-recu.js : sa requête doit contenir where('to','==', uid),
    // sinon Firestore la refuse. Envoie-le-moi pour vérifier.
  }
}
